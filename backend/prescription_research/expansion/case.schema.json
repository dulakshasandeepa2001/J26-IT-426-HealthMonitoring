{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic-only static rule-check input; contains no review identities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "synthetic_only",
    "fact_origin",
    "condition",
    "patient_features"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "synthetic_only": {
      "const": true
    },
    "fact_origin": {
      "const": "synthetic_researcher_defined"
    },
    "condition": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 50
    },
    "patient_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "age_years": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 120
        },
        "weight_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.1,
          "maximum": 350
        },
        "onset_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 8760
        },
        "symptoms": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "fever": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present",
                "duration_hours"
              ],
              "properties": {
                "present": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "duration_hours": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 8760
                }
              }
            },
            "body_aches": {
              "type": "object",
